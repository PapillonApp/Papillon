{
  "name": "papillon-intents",
  "version": "0.1.0",
  "description": "Generic bridge between Apple App Intents",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "ios",
    "plugin",
    "src",
    "app.plugin.js",
    "expo-module.config.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf build",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "keywords": [
    "expo",
    "expo-module",
    "app-intents",
    "appintents",
    "siri",
    "apple-intelligence",
    "shortcuts",
    "spotlight",
    "ios",
    "react-native"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/strellastudio/papillon-intents.git"
  },
  "author": "Lucas Lavajo <lucas@papillon.fr>",
  "license": "MIT",
  "homepage": "https://papillon.bzh",
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/react": "*",
    "expo": "*",
    "typescript": "*"
  }
}
