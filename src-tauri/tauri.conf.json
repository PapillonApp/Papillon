{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scola",
  "version": "1.0.0",
  "identifier": "bzh.papillon.scola",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Scola",
        "width": 1300,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installerHeader.bmp",
        "sidebarImage": "icons/installerSidebar.bmp"
      }
    }
  }
}
