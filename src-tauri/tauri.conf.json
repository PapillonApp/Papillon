{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Papillon",
  "version": "0.1.0",
  "identifier": "xyz.getpapillon.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run export:web",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "npm run web"
  },
  "app": {
    "windows": [
      {
        "title": "Papillon",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
